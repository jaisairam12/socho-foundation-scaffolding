# SOCHOYHAPE — environment variables
#
# Copy this file to `.env` and fill in values. Never commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser; everything
# else is server-only and must be read inside server functions.
#
# Nothing below is required for the current phase (foundation / app shell).
# Variables are listed so later phases have one agreed place to add config.

# --- App -------------------------------------------------------------------
# Public name shown in the shell header and page titles.
VITE_APP_NAME=SOCHOYHAPE
# Environment label: development | preview | production
VITE_APP_ENV=development

# --- Backend (not enabled in this phase) -----------------------------------
# Lovable Cloud injects these automatically when it is enabled. Leave empty.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI (not implemented in this phase) ------------------------------------
# Reserved. No AI features exist yet and none are mocked.
# LOVABLE_API_KEY=
